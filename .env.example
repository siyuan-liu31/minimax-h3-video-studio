# Both application processes should stay on loopback behind an SSH tunnel.
H3_STUDIO_HOST=127.0.0.1
H3_STUDIO_PORT=6020
# Optional for loopback/SSH use. If enabled for a public deployment, set the
# same strong random value here and in H3_STUDIO_PROXY_API_KEY below.
H3_STUDIO_API_KEY=
H3_STUDIO_CORS_ORIGINS=http://127.0.0.1:3013,http://127.0.0.1:16020

COMFY_URL=http://127.0.0.1:6006
# Unified FIFO GPU scheduler for ComfyUI and persistent voice workers.
H3_STUDIO_GPU_DEVICE_INDEX=0
H3_STUDIO_GPU_IDLE_RELEASE_SECONDS=180
H3_STUDIO_GPU_POLL_SECONDS=2
# Deprecated compatibility alias for GPU_IDLE_RELEASE_SECONDS.
H3_STUDIO_COMFY_IDLE_FREE_SECONDS=180
# H3 Ref2VA long-sequence safety policy and resumable Base sampling.
H3_STUDIO_GPU_ARCHITECTURE=auto
H3_STUDIO_ATTENTION_BACKEND=SageAttention
H3_STUDIO_H3_TOKEN_RISK_THRESHOLD=150000
H3_STUDIO_CHECKPOINT_TTL_HOURS=48
H3_STUDIO_CHECKPOINT_GC_SECONDS=1800
H3_STUDIO_DATA_ROOT=/path/to/h3-studio-data
H3_STUDIO_COMFY_INPUT=/path/to/ComfyUI/input
H3_STUDIO_COMFY_OUTPUT=/path/to/ComfyUI/output
H3_STUDIO_MAX_ASSET_STORAGE_BYTES=214748364800
H3_STUDIO_MAX_MOTION_CONTEXT_STORAGE_BYTES=214748364800
H3_STUDIO_MAX_PROJECT_JSON_BYTES=33554432
H3_STUDIO_MAX_ACTIVE_JOBS=4
H3_STUDIO_ASSET_TTL_DAYS=30

# Optional voice-conversion runtimes. Keep repositories/environments outside
# immutable application releases and pin them to the reviewed revisions.
H3_STUDIO_MAX_ACTIVE_VOICE_TASKS=16
H3_STUDIO_VOICE_WORKER_START_SECONDS=1200
H3_STUDIO_VEVO2_ROOT=/path/to/voice-runtimes/Amphion
H3_STUDIO_VEVO2_PYTHON=/path/to/conda/envs/h3-voice/bin/python
H3_STUDIO_VEVO2_REVISION=26f6883110181f1dbfe95c70a7c7dbaf4de5f42a
H3_STUDIO_VEVO2_MODEL_REVISION=2674843cbaa50aa89ee7ccaf5bb15d6ccf46c6c8
H3_STUDIO_YINGMUSIC_ROOT=/path/to/voice-runtimes/YingMusic-SVC
H3_STUDIO_YINGMUSIC_PYTHON=/path/to/conda/envs/h3-voice/bin/python
H3_STUDIO_YINGMUSIC_REVISION=4974a80c6044c4557059548409379f6365129f88
H3_STUDIO_YINGMUSIC_MODEL_REVISION=da6b73938afeb7ede4c8d93ef007af2abb04ef49
H3_STUDIO_YINGMUSIC_SEPARATOR_CONFIG=/path/to/voice-runtimes/YingMusic-SVC/accom_separation/ckpt/bs_roformer/config_bd_roformer.yaml
H3_STUDIO_YINGMUSIC_SEPARATOR_CHECKPOINT=/path/to/voice-models/bs_roformer.ckpt
H3_STUDIO_YINGMUSIC_SVC_CONFIG=/path/to/voice-runtimes/YingMusic-SVC/configs/YingMusic-SVC.yml
H3_STUDIO_YINGMUSIC_SVC_CHECKPOINT=/path/to/voice-models/YingMusic-SVC-full.pt

H3_STUDIO_FL_MODEL=minimax_h3_fl2va_pruned_int8_convrot.safetensors
H3_STUDIO_REF_MODEL=minimax_h3_ref2va_pruned_int8_convrot.safetensors
H3_STUDIO_TEXT_ENCODER=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
H3_STUDIO_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
H3_STUDIO_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
H3_STUDIO_FL_LORA=minimax_h3_fl2v_lightx2v_turbo_4step_v1.0_768p_resized_avg_rank_31_bf16.safetensors
H3_STUDIO_REF_LORA=minimax_h3_ref2v_lightx2v_turbo_4step_v0.1_resized_avg_rank_20_bf16.safetensors
H3_STUDIO_IMAGE_CHECKPOINT=anything-v5-PrtRE.safetensors

# Read by Vite/vinext on the server only; neither value is bundled into the UI.
H3_STUDIO_API_PROXY=http://127.0.0.1:6020
H3_STUDIO_PROXY_API_KEY=

# Douyin imports: yt-dlp executable and optional private Netscape cookie file.
H3_STUDIO_YTDLP=yt-dlp
H3_STUDIO_DOUYIN_COOKIES=
